# =====================================================================
# LLM API Configuration for Offline Labeling & BERTopic Representation
# =====================================================================

# Option 1: Google Gemini API (Recommended: fast, high free-tier rate limit)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API (or compatible providers like OpenRouter, Groq, DeepSeek, Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# General settings
LLM_PROVIDER=gemini

